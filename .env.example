VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT=common
# Opcional. Se calcula desde la ruta pública: localhost o /MiPanel/ en GitHub Pages.
# Solo es necesario para un dominio o una ruta de redirección personalizada.
VITE_MICROSOFT_REDIRECT_URI=

# Configuración pública de Supabase. Nunca incluir aquí service_role,
# client secrets ni tokens de Microsoft.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
