# Microsoft Entra / Graph (valores predeterminados opcionales; también se pueden
# introducir y cambiar desde el diálogo de la extensión sin recompilar)
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT=common

# El Client ID y el tenant son públicos. El redirect se obtiene en ejecución con
# chrome.identity.getRedirectURL('microsoft') y depende del ID de la extensión.

# Google OAuth / Calendar
VITE_GOOGLE_CLIENT_ID=

# Cualquier variable VITE_* es pública y queda incluida en el bundle: nunca
# guardar secretos aquí.
