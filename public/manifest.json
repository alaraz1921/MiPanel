{
  "manifest_version": 3,
  "name": "MiPanel",
  "version": "0.5.3",
  "description": "Panel personal de productividad para la página de nueva pestaña.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
